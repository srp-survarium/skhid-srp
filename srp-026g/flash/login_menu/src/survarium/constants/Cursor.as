package survarium.constants
{
   // A mouse cursor (set_mouse_cursor: the cursor movie's frame).
   public class Cursor
   {
      
      public static const ARROW:int = 1;
      
      public static const BUTTON:int = 2;
      
      public static const OPEN_HAND:int = 3;
      
      public static const GRAB:int = 4;
      
      public static const ROTATE_HAND:int = 5;
      
      public static const IBEAM:int = 6;
      
      public static const MOVE:int = 7;
      
      public static const RESIZE_NESW:int = 8;
      
      public static const RESIZE_NWSE:int = 9;
      
      public static const ADD:int = 10;
      
      public static const REMOVE:int = 11;
      
      public static const WAIT:int = 12;
      
      public function Cursor()
      {
         super();
      }
   }
}
