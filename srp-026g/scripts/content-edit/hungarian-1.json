{
  "_about": "Hungarian. Copy English support resources, translate every dictionary key, and include missing stock UI keys. The EULA and profanity data remain English; they are not Hungarian translations.",
  "copy": [
    {
      "files": "localization/english/*",
      "from": "localization/english/",
      "to": "localization/hungarian/"
    }
  ],
