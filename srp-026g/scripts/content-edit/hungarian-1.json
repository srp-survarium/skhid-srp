    {
      "file": "localization/english/localization",
      "target": "localization/hungarian/localization",
      "translations": "../../client-patches/localization/hungarian.tsv",
      "keep": "../../client-patches/localization/hungarian_keep.txt",
      "latin": true,
      "extra": [
        "st_bonus_victory",
        "st_change_profile",
        "st_checkbox_players_live_search",
        "st_checkbox_show_player_groups",
        "st_choose_faction_button_hint",
        "st_friend_options_label",
        "st_label_status",
        "st_slots",
        "st_special_offer"
      ]
    }
  ]
}
