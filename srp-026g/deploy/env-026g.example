# Settings for the 0.26g server's docker-compose.yml. Copy to `.env` beside
# the compose file and fill in. Secrets live only in that `.env`, never in a
# repository. A change takes effect when the container is made anew:
# `docker compose up -d --no-deps --force-recreate srp26`. `docker compose
# restart` keeps the settings the container was made with.

# The address players reach the host at (IPv4, or a name with an A record).
SRP_PUBLIC_HOST=203.0.113.9

# The game ports, the same inside and outside the container. These defaults
# do not clash with a 0.21d server on the same host (1234 tcp+udp, 1235 tcp,
# 1236 udp).
# On a host of its own use the game's: 1234, 1235, 1236.
SRP26_LOGIN_PORT=2234
SRP26_LOBBY_PORT=2235
SRP26_MATCH_PORT=2236
# The web page, on 127.0.0.1 of the host (the 0.21d page has 8088).
SRP26_WEB_PORT=8098

# The admin page: off unless both are set. The path is a long random name.
SRP_ADMIN_TOKEN=
SRP_ADMIN_PATH=
# Who may open it. Through an SSH tunnel the page sees Docker's bridge
# gateway (for example 172.19.0.1): list that address.
SRP_ADMIN_IPS=127.0.0.1
SRP_WEB_TRUST_PROXY=off

# The web page's public name, for HTTPS (the caddy26 service, profile
# `tls`, on a host whose port 443 is free). With it set SRP_WEB_TRUST_PROXY
# to on and put your own public IP in SRP_ADMIN_IPS.
# SRP_WEB_DOMAIN=example.org
# Several names: commas between them, the whole in quotes.
# SRP_WEB_DOMAIN="example.org, www.example.org"
# The page of another server of ours: every page's header links to it, as
# the server for the other game version. https only. Leave it out where
# there is none.
# SRP_OTHER_SERVER_URL=
# A test server: every page says that it is one, and SRP_OTHER_SERVER_URL
# is then named in the notice as the players' server.
# SRP_TEST_SERVER=on

# The download the home page offers: a zip in ./download, or a https link.
# SRP_DOWNLOAD_FILE=/srv/srp/download/Survarium-0.26g-srp-files.zip
# The server's game data (server-game-data.db: srp-game-data build of
# resources.db and the patches the players mount, with the URLs the players
# download them from). srp takes its game tables from it, lists its patches
# at /patches, and does not start without it. The compose file's default:
# ./download/server-game-data.db on the host. A release replaces it, sets
# SRP_MIN_PATCH_REVISION (below) and recreates srp26: `docker compose up -d
# --no-deps --force-recreate srp26` (docs/DEPLOY.md, "The game's files").
# SRP_GAME_DATA=/srv/srp/download/server-game-data.db
# Where the original game is had (the compose file's default is the web
# archive's copy of build 2777).
# SRP_GAME_URL=
# SRP_DOWNLOAD_URL=
# SRP_DOWNLOAD_SHA256=

# "Watch replay" (docs/notes/replay_watch.md): on with the compose
# default, a folder of the data volume with the game's
# gameplay/game_modes/*.options files, every patch's included (game data:
# copy them there by hand, never into a repository); `off` switches it off.
# The replays go to SRP_REPLAY_DIR (compose default /srv/srp/data/replays).
# SRP_GAME_MODES_DIR=/srv/srp/data/game_modes
# A larger recording is not converted (the conversion's memory grows with
# it; 24 MB fits the 512 MB container).
# SRP_REPLAY_MAX_RECORDING_MB=24
# The replays (.sur and .json in SRP_REPLAY_DIR) over this many MB
# together: the oldest are deleted (made again when asked for). Apart from
# SRP_RECORD_MAX_MB.
# SRP_REPLAY_MAX_MB=1000

# Resources. Beside another server on a small host, check `free -m` first.
SRP26_CPUS=1
SRP26_MEMORY=512m

RUST_LOG=info

# FOR TESTING ONLY, never on a public server: the accounts that are test
# bots (srp-bot). A match of one real client and bots trusts that client's
# world on its word alone. Leave it out. (The compose file does not pass it:
# it is for srp run by hand.)
# SRP_BOT_ACCOUNTS=bot-1,bot-2

# Optional game settings (srp's defaults when left out; see SRP-026G.md):
# SRP_REGISTRATION=closed
# SRP_MATCH_GATHER_SECONDS=60
# SRP_MATCH_MODES=2,3,4
# The most players of a side (1 to 10), and how many seconds of waiting
# widen a player's range of levels by one (raise it on a full server).
# SRP_MATCH_TEAM_SIZE=8
# SRP_MATCH_SEARCH_STEP_SECONDS=4
# What a player counts for when the sides of a match are made, in gear
# levels: by being there (with an odd count the side with a player more has
# this much more, so the stronger players are the side of fewer), for a
# level of its account, and for a point of its balance rating; and the
# matches after which that rating counts for half. The defaults:
# SRP_BALANCE_PLAYER=12
# SRP_BALANCE_PLAYER_LEVEL=1.5
# SRP_BALANCE_RATING=4
# SRP_BALANCE_TRUST_MATCHES=5
# The fewest players a match must have had in it, for half of it or more,
# to move the balance rating: 4 leaves out one against one and two against
# one. 1: every match moves it.
# SRP_BALANCE_RATED_PLAYERS=4
# Games of patch revision 5 or later join matches that are being played.
# A match of theirs starts with this many players, this long after the
# second one pressed Play, and takes who comes later:
# SRP_GROWING_MIN_PLAYERS=2
# SRP_GROWING_GATHER_SECONDS=120
# A player who joins goes where the sides then count most alike: the
# players in the match, what they count for (above), and the lead. What a
# battery and a ticket of lead count for, in players; the lead, in players,
# from which the side that trails may get two players more than the other
# (5 batteries, 13 tickets); and how long a player who would make an even
# match uneven waits for another before it goes in:
# SRP_BALANCE_BATTERY_LEAD=0.55
# SRP_BALANCE_TICKET_LEAD=0.2
# SRP_BALANCE_DRAMATIC_LEAD=2.5
# SRP_LATE_JOIN_PATIENCE_SECONDS=60
# No squads: an invite is refused, and its sender is told in a message box.
# SRP_SQUADS=off
# SRP_SQUADS_OFF_TEXT=Squads are switched off on this server.
# The most players of a squad: 3 (the game's own limit) or 2. An invite
# from a full squad is not passed on, and its sender is told in a message
# box (default text: "Squads are limited to <size> players.").
# SRP_SQUAD_SIZE=2
# SRP_SQUAD_FULL_TEXT=Squads are limited to 2 players.
# A game older than this patch revision (what the exe says at its sign-in)
# is refused at its sign-in with the game's own "outdated version", and its
# sessions from before a restart in the lobby. Left out (or 0): every game
# is let in; a value that is not a number from 0 to 255 stops srp at start.
# It must be at least the newest patch of the game data (resources.db.patch_<n>
# is n): srp does not start with less, as an older game would crash on that
# patch's items. Its log then says what to set.
# SRP_MIN_PATCH_REVISION=14
# A silent client: its lobby link goes after the first (the second for a
# player in a match), and its session waits the third for the client to
# connect again by itself.
# SRP_LOBBY_LINK_TIMEOUT_SECONDS=30
# SRP_LOBBY_MATCH_LINK_TIMEOUT_SECONDS=120
# SRP_LOBBY_SESSION_GRACE_SECONDS=60
# SRP_MATCH_MAPS=
# How much the map draw leans to the maps a match's players played less:
# a map 5 or more plays behind their most-played one weighs 1 + this (0:
# every map alike; 0 to 4).
# SRP_MATCH_MAP_SKEW=1
# What a match pays: its experience times this (1 is the original's pace;
# the owner's choice: 2).
# SRP_EXPERIENCE_RATE=2
# The percent of the original's silver a match pays. Unset, it goes by the
# match's level (the owner's choice): 150 at levels 0 to 5, ten more each
# level, 220 from level 12. Set, it is that percent at every level.
# SRP_MONEY_RATE=
# The percent of the original's reputation a match and its quests pay (the
# owner's choice: 120).
# SRP_REPUTATION_RATE=120
# Whether a match wears the weapons and armour played with (the game's own
# rule; a worn item may then get a defect). Off by the owner's choice: an
# item stays as it is. The first start with it off makes every worn item of
# every account whole, once.
# SRP_ITEM_WEAR=off
# A weapon or armour found after a match arrives at this percent of its
# condition, and with one defect (off: without).
# SRP_DROP_CONDITION=40
# SRP_DROP_DEFECT=on
# Whether the first four games of an hour of play raise the chance of
# finding something (the game's data has the numbers, not how they were
# used). Off by the owner's choice: every match has the table's 40 %, plus
# the batteries' and premium's parts.
# SRP_DROP_PLAYTIME_BONUS=off
# The daily bonus (double experience and reputation for a day's first three
# victories, a reward for seven such days). off: none of it. A bonus day
# starts at this hour of UTC (0 to 23).
# SRP_DAILY_BONUS=on
# SRP_DAILY_BONUS_RESET_HOUR=0
# Clans: silver to register one, and its most members (srp's defaults).
# SRP_CLAN_COST=50000
# SRP_CLAN_MAX_MEMBERS=30

# "Player vs Bots": one player against the server's own bots, chosen in
# the changed lobby movie (servers/lobby-server/src/v026g/pvb.rs). On with
# the compose default; `off` switches it off. The highest equipment level
# let in, the most such matches at once (the server keeps a bots' map in
# memory for each, 35-150 MB: with 5, give SRP26_MEMORY about 750 MB
# more), the share of silver and experience they pay, and the seconds
# after which a match whose player uploads no world it is asked for is
# over.
# SRP_PVB=on
# SRP_PVB_MAX_GEAR=5
# SRP_PVB_MAX_MATCHES=5
# SRP_PVB_PAY=0.5
# SRP_PVB_STALL_S=60
# The bots' maps (docs/notes/player_bots_mapdata.md section 6): the
# <project>.mapdata files, copied by hand into the data volume (game data:
# never into a repository). Compose default /srv/srp/data/mapdata; `off`:
# no maps. The server writes what it builds of them to <dir>/built (or
# SRP_MAPDATA_BUILT; `off`: built at each load), keeps SRP_MAPDATA_KEEP
# built maps no match holds, and has at most SRP_MAPDATA_AT_ONCE in
# memory (with Player vs Bots on, at least SRP_PVB_MAX_MATCHES).
# SRP_MAPDATA_DIR=/srv/srp/data/mapdata
# SRP_MAPDATA_BUILT=/srv/srp/data/mapdata/built
# SRP_MAPDATA_KEEP=1
# SRP_MAPDATA_AT_ONCE=1

# Players who must accept before a clan is registered. The code's default is
# 1; the game's own text (`st_clan_creation_info_description`) says "you need
# to enlist at least 5 players".
SRP_CLAN_PLAYERS_REQUIRED=5
