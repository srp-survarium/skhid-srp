# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Per-server log files written by the unified `srp` binary
logs/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# The accounts database and its backups (SRP_DATA_DIR)
/data/

# Build folders of parallel test runs, and local test data
target-*/
/data-*/
/download/

# Python caches of the scripts
__pycache__/

# The client patches' generated sources: written by every link of the exe's
# arena (client-patches/patch_026g.py's generate_sources), never committed
/client-patches/engine_026g.asm
/client-patches/engine_026g.h
/client-patches/engine_026g.inc
/client-patches/engine_026g.rs
/client-patches/raw_026g.rs
/client-patches/hooks_026g.rs
/client-patches/hook_entries_026g.asm
/client-patches/languages_026g.rs
