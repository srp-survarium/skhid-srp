// The updater's version information and icon (../build.rs, ../../../windows_build.rs
// fills in the @...@: the Skhid release revision, or a local build's 0).
// The icon is the game's own (the original Survarium launcher's and
// survarium.exe's, 16 to 256 pixels).

1 ICON "@DIR@/res/skhid.ico"

1 VERSIONINFO
FILEVERSION @VERSION_FIXED@
PRODUCTVERSION @VERSION_FIXED@
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Skhid"
            VALUE "FileDescription", "Skhid updater"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "updater_skhid"
            VALUE "LegalCopyright", "© 2026 Skhid"
            VALUE "OriginalFilename", "updater_skhid.exe"
            VALUE "ProductName", "Skhid"
            VALUE "ProductVersion", "@PRODUCT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
