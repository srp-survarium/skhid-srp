#!/usr/bin/env bash
# usage: release/deploy --zip <zip> --server-data <db> --revision <n> [--label <word>] [--dry-run]
#
# Puts a release on the live host ($SKHID_LIVE through $SKHID_JUMP, in
# $SKHID_LIVE_DIR), in a maintenance window planned by hand. release/release.sh
# does the same and more (maintenance, staging, the build) in one run; this is
# the step on its own:
#   1. checks here: the ZIP's exe says patch revision <n>; the server data
#      reads (srp-game-data info), offers no patch above <n>, offers
#      patch_12 (the menus) from revision 12 on, and offers exactly the
#      patches of release/patches.tsv, which the ZIP's exe requires, no
#      more and no fewer (patch 49);
#   2. takes the release lock on the jump host; reads srp26's container (its
#      image ID, its data volume), the files in download/, the setting;
#   3. makes the release folder release-rev<n>-<UTC YYYYMMDD-HHMM>[-<label>]
#      there and uploads both files into it (sha256 checked, chmod 644);
#   4. the swap: stops srp26; keeps srp.db (and its write-ahead log) in the
#      folder and copies it to the jump host; keeps the old files (hard
#      links), their sha256, the image ID, the setting; tags the running
#      image srp-026g:before-rev<n>-<stamp>; puts the rollback in the folder;
#   5. the server data and the ZIP into place (hard links renamed over the
#      old ones, while srp26 is stopped: the site never offers the old ZIP
#      beside the new /patches and revision), SRP_MIN_PATCH_REVISION=<n> in
#      .env (that one line; the file is never printed), docker compose up -d
#      --no-deps --force-recreate srp26;
#   6. checks the container (running, healthy, not restarting), its log's
#      game data line, $SKHID_SITE/patches and /game (the list's files, any
#      rows of srp's mirrors.tsv after each one's URLs) and
#      $SKHID_SITE/api/client-files
#      (the new ZIP; min-revision <n> from an srp that says it).
# A failure in 5-6 prints srp's log (a refusal to start says why there) and
# runs the folder's rollback, srp.db included, then checks srp26 is up on
# the old files. Its output goes in the folder as release.log. Every write
# on the live host asks y/N first, showing the command; a no stops there.
# Reads (ls, sha256sum, grep of that one setting) just run.
#
#   --label <word>  ends the folder's name
#   --dry-run       prints every command, runs none on the live host
#
# Server code changed? Build the image first (docker compose build srp26):
# the restart runs what srp-026g:latest is then; the rollback tags the image
# that ran before.
. "$(dirname "$0")/lib.sh"

zip='' data='' revision='' label=''
while (($#)); do
    case $1 in
    -h | --help) usage ;;
    --zip) (($# >= 2)) || usage 1; zip=$2; shift 2 ;;
    --server-data) (($# >= 2)) || usage 1; data=$2; shift 2 ;;
    --revision) (($# >= 2)) || usage 1; revision=$2; shift 2 ;;
    --label) (($# >= 2)) || usage 1; label=$2; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    *) die "unknown argument $1 (--help)" ;;
    esac
done
[[ -n $zip && -n $data && -n $revision ]] || usage 1
is_revision "$revision" || die "$revision: a revision is a number from 1 to 255"
[[ -z $label || $label =~ ^[A-Za-z0-9._-]+$ ]] || die "$label: a label is letters, digits, . _ -"
[[ -f $zip ]] || die "$zip: no such file"
[[ -f $data ]] || die "$data: no such file"
need_cmds ssh curl sha256sum jq od
use_target live
use_patches live

work=$(mktemp -d)
SWAP_WORK=$work
log_to "$work/release.log"
on_exit() {
    local status=$?
    set +e
    trap - INT TERM
    swap_failed
    if [[ -z $SWAP_STATE ]]; then stage_abandon; fi
    save_release_log "$work/release.log"
    lock_drop
    rm -rf "$work"
    exit "$status"
}
trap on_exit EXIT
trap 'die "interrupted"' INT TERM

# 1. Here.
check_release_files "$zip" "$data" "$revision" "$work"
read_patch_list
[[ $OFFERED == "$(offered_of_list "")" ]] ||
    die "$data does not offer exactly the patches of $PATCH_LIST (build it with release/build-server-db)"
[[ $OFFERED_GAME == "$GAME_ROW" ]] ||
    die "$data does not name the game's archive of $GAME_LIST (build it with release/build-server-db)"
check_exe_requires "$zip" "$work"
say "ZIP: $zip, $ZIP_SIZE bytes, sha256 $ZIP_SHA, patch revision $revision"
say "server data: $data, sha256 $DATA_SHA; /patches will offer:"
say_offered

# 2. What is there now.
say
say "on the live host now:"
read_live "cd $D && ls -l download/$ZIP_NAME download/$DATA_NAME 2>&1; grep -E '^SRP_MIN_PATCH_REVISION=' .env || echo 'SRP_MIN_PATCH_REVISION: not in .env'"
if ((DRY_RUN)); then
    RUN_IMAGE='<the running image ID>' RUN_VOLUME='<its data volume>'
    HAVE_ZIP=1 HAVE_DATA=1 OLD_MIN='<as now>'
else
    lock_take
    OLD_MIN=$(current_min_revision)
    inspect_target || die "srp26 has no container on the live host (or docker inspect failed)"
    say "srp26: container ${RUN_CONTAINER:0:12}, image $RUN_IMAGE, data volume $RUN_VOLUME"
    if [[ $LATEST_IMAGE != "$RUN_IMAGE" ]]; then
        say "NOTE: $IMAGE is $LATEST_IMAGE, not the running image: the restart runs that one"
    fi
    present=$(on_target "cd $D && for f in download/$ZIP_NAME download/$DATA_NAME; do if test -f \$f; then echo \$f; fi; done")
    [[ $present == *"$ZIP_NAME"* ]] && HAVE_ZIP=1
    [[ $present == *"$DATA_NAME"* ]] && HAVE_DATA=1
    OLD_PATCHES=$(served_patches)
    blobs=$(missing_original_blobs)
    [[ -z $blobs ]] || die "download/resources/ lacks the original blobs the updater's restore fetches: $(tr '\n' ' ' <<<"$blobs")"
    set_now=$(env_settings_set "$(on_target "cat $D/docker-compose.yml 2>/dev/null" || true)" || echo "(not readable)")
    if [[ -n $set_now ]]; then say "NOTE: the compose file passes on $set_now, which the .env sets (names only): those values take effect at the recreate"; fi
fi
stats=$(curl -sS --max-time 20 "$TARGET_SITE/api/stats" || true)
matches=$(jq -r '.matches // "unknown"' <<<"$stats" 2>/dev/null || echo unknown)
say "matches running now: $matches (the swap ends every one)"

# 3. Staged in the release folder.
release_folder "$revision" "$(date -u +%Y%m%d-%H%M)" "$label"
stage_begin
stage_upload "$data" "$DATA_NAME" "$DATA_SHA"
stage_upload "$zip" "$ZIP_NAME" "$ZIP_SHA"

# 4.-6. The swap.
swap_prepare "$revision"
swap_server "$revision"
swap_finish
if ((DRY_RUN)); then
    say "[dry run] then: srp26 running, its game data line, GET $TARGET_SITE/patches must be $EXPECTED,"
    say "[dry run] and GET $TARGET_SITE/api/client-files must say sha256 $ZIP_SHA, size $ZIP_SIZE"
    say "[dry run] a failure there: srp's log, then sh $TARGET_DIR/$REL/rollback.sh $TARGET_DIR/$REL on the live host"
    exit 0
fi
say
say "deployed revision $revision. Its folder: $TARGET_DIR/$REL (the files before it, srp.db, the image IDs, release.log); the old image is $BEFORE_TAG"
say "Rollback: release/rollback $REL (or on the live host: sh $TARGET_DIR/$REL/rollback.sh $TARGET_DIR/$REL; srp.db back too, --keep-db keeps today's)"
say "Now: a game updates, downloads the patches, signs in; an old game is refused."
