#!/usr/bin/env bash
# usage: release/build-torrent --zip <players' ZIP> --out <file> --zip-out <ZIP>
#                              --revision <n> [--public-key <file>] [--test] [--patches <list>]
#                              [--bootstrap <file> [--bootstrap-list <bootstrap.tsv>]]
#
# The signed torrent of a revision's whole game folder
# (srp-026g/docs/notes/torrent-downloads.md, "The format"), and --zip-out: the
# ZIP with it as game/torrent/skhid.torrent, with --bootstrap's torrent
# as game/torrent/skhid-bootstrap.torrent, and (--bootstrap-list) the
# bootstrap's pinned files the ZIP has other bytes of, fetched by their rows'
# URLs, in game/torrent/bootstrap/: the updaters seed the bootstrap from there.
# The folder: the original game's files (from $SKHID_GAME and
# $SKHID_STOCK_DB, each against build 2777's sha256), the ZIP's files over
# them, and the offered patches (lib.sh cache_patches). Signed with
# lib.sh signing_key, which must verify with --public-key (default this
# checkout's; release.sh passes the built commit's). The same inputs make the
# same bytes. Prints the info hashes (`btih`, `btmh 1220...`).
. "$(dirname "$0")/lib.sh"

# The original game's files but resources.db: `<path under game/> <sha256>`
# of build 2777 (the exe's is game.rs's ORIGINAL_EXE).
GAME_FILES=(
    "binaries/x86/survarium.exe ac33d9937015c2299bf62cc6b127cb308b48a3475b30fff2ddd65479ae3bf153"
    "binaries/x86/bugtrap.dll 5bb81aea946767ad860522fc638b267e7e972c1e3d8af7a390c1714c1e9a8aac"
    "resources/ssl/survarium_login_server.crt f29e488d406815c66a4541599c3bb8816a623dddcd995b588c902074ae8c7b68"
    "resources/sources/splash_screens/development_engine.bmp f81222a3463da4cc5e8af193cf41f15199368b44f1938f6a2bad6107c1aac00f"
)

zip='' out='' zip_out='' which=live patches='' revision='' public='' bootstrap='' bootstrap_list=''
while (($#)); do
    case $1 in
    -h | --help) usage ;;
    --zip) (($# >= 2)) || usage 1; zip=$2; shift 2 ;;
    --out) (($# >= 2)) || usage 1; out=$2; shift 2 ;;
    --zip-out) (($# >= 2)) || usage 1; zip_out=$2; shift 2 ;;
    --revision) (($# >= 2)) || usage 1; revision=$2; shift 2 ;;
    --public-key) (($# >= 2)) || usage 1; public=$2; shift 2 ;;
    --bootstrap) (($# >= 2)) || usage 1; bootstrap=$2; shift 2 ;;
    --bootstrap-list) (($# >= 2)) || usage 1; bootstrap_list=$2; shift 2 ;;
    --test) which='test'; shift ;;
    --patches) (($# >= 2)) || usage 1; patches=$2; shift 2 ;;
    *) die "unknown argument $1 (--help)" ;;
    esac
done
[[ -n $zip && -n $out && -n $zip_out && -n $revision ]] || usage 1
is_revision "$revision" || die "--revision $revision: a revision is 1 to 255"
[[ -f $zip ]] || die "$zip: no such file"
[[ -z $bootstrap || -f $bootstrap ]] || die "--bootstrap $bootstrap: no such file"
public=${public:-$ROOT/$(signing_pub "$which")}
[[ ! -e $out && ! -e $zip_out ]] || die "$out or $zip_out: already there; never overwritten"
need_cmds curl sha256sum
lower_priority
load_env SKHID_GAME SKHID_STOCK_DB
game=$SKHID_GAME
[[ -f $game/binaries/x86/survarium.exe ]] || game=$SKHID_GAME/game
[[ -f $SKHID_STOCK_DB ]] || die "SKHID_STOCK_DB: $SKHID_STOCK_DB: no such file"
key=$(signing_key "$which")
[[ -f $key ]] || die "$key: no signing key (every torrent is signed): make it once with release/make-signing-key$([[ $which == test ]] && printf ' --test') and commit $(signing_pub "$which")"
[[ $(stat -c %a "$key") == 600 ]] || die "$key: mode $(stat -c %a "$key"), not 600"
[[ -f $public ]] || die "$public: no public key (release/make-signing-key writes $(signing_pub "$which"))"
openssl=$(openssl_program)
use_patches "$which"
if [[ -n $patches ]]; then PATCH_LIST=$patches; fi
read_patch_list
cache_patches

args=(--zip "$zip" --out "$out" --zip-out "$zip_out" --revision "$revision"
    --key "$key" --public-key "$public" --openssl "$openssl"
    --file game/resources.db "$SKHID_STOCK_DB" "${SKHID_TEST_STOCK_SHA256:-$STOCK_DB_SHA256}")
for row in "${GAME_FILES[@]}"; do
    read -r path sha <<<"$row"
    args+=(--file "game/$path" "$game/$path" "$sha")
done
while read -r name sha _; do
    if [[ -n $name ]]; then args+=(--file "game/$name" "$PATCH_CACHE/$name" "$sha"); fi
done <<<"$LIST"
say "building $out: the original game's files, $(grep -c . <<<"$LIST") patch(es) of $PATCH_LIST, the files of $zip"
# The bootstrap torrent rides in the ZIP too, for the updaters to seed it, with
# the pinned files no longer live.
if [[ -n $bootstrap ]]; then args+=(--bootstrap "$bootstrap"); fi
if [[ -n $bootstrap && -n $bootstrap_list ]]; then
    copies=$(mktemp -d)
    trap 'rm -rf "$copies"' EXIT
    while IFS=$'\t' read -r name sha _ urls; do
        [[ -n $name && $name != \#* ]] || continue
        zip_extract "$zip" "game/binaries/x86/$name" "$copies/live" || true
        [[ -f $copies/live && $(sha256_of "$copies/live") == "$sha" ]] && continue
        for url in $urls; do
            [[ $(http_get "$url" "$copies/$name") == 200 && $(sha256_of "$copies/$name") == "$sha" ]] && break
            rm -f "$copies/$name"
        done
        [[ -f $copies/$name ]] || die "the bootstrap's $name (sha256 $sha): none of its URLs gave it"
        say "the bootstrap's $name is not the ZIP's: its pinned copy goes in the ZIP"
        args+=(--bootstrap-copy "$name" "$copies/$name")
    done <"$bootstrap_list"
fi
python -I "$(dirname "$0")/build_torrent.py" "${args[@]}"
