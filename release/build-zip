#!/usr/bin/env bash
# usage: release/build-zip [--test] [--ref <commit>] [--revision <n>] [--patches <list>] [--work <dir>]
#
# Builds the players' ZIP from a fresh worktree of origin/main and compares it
# with the one the site hands out now, entry by entry:
#   1. git fetch origin main; a new worktree of it in <work>/src (never this
#      checkout, never git stash);
#   2. the current ZIP from $SKHID_SITE/download and its exe's revision; the
#      build's revision is that + 1 (or --revision <n>, which must be above
#      it; --test: any, from patch_026g.py's REVISION). Nothing is edited:
#      the revision is passed to the build;
#   3. bugtrap.dll and updater_skhid.exe (nix develop ./srp-026g,
#      SKHID_REVISION=<n>: their version resource says it;
#      SKHID_BUILTIN_PATCHES and SKHID_BUILTIN_GAME: the list's /patches and
#      /game, which the updater uses when the server cannot be reached), then
#      make_client_026g.py $SKHID_GAME ... --pack-zip --revision=<n>
#      --required-patches=<the list's> --downloads=<release/game.tsv>
#      --downloads=<the list>
#      --server=$SKHID_GAME_SERVER --site=$SKHID_SITE (no language: the game
#      keeps its own, patch 79; no resources.db regions: patches come from
#      the server's /patches; --downloads: the list's files and URLs written
#      into Skhid-without-updater.bat, for when the server cannot be
#      reached), and
#      patch_026g.py --revision=<n> --required-patches=<the list's> without
#      a server, for the record's second hash (both in the dev shell: the
#      exe's arena is linked from source with its gcc, ld and NASM 2.16,
#      and must be client-patches/arena_026g.lock.json's). The required patches (patch
#      49): every patch of the offered-patch list (release/patches.tsv;
#      --test: patches-test.tsv; --patches: another), so the exe stops at
#      its start, "Cannot open resources.db.patch_<n> ... run the Skhid
#      launcher again", without one the release's server offers; both exes
#      are read back for it;
#   4. prints every entry as same / CHANGED / ADDED / REMOVED against the
#      current ZIP, and says whether updater_skhid.exe changed.
# <work>/exe.sha256: `<sha256> with-server` (the ZIP's exe) and
# `<sha256> without-server`, for the record (release.sh reads it).
#
#   --test          for the test environment: --server=$SKHID_TEST_GAME_SERVER
#                   --site=$SKHID_TEST_SITE, compared with the ZIP of
#                   $SKHID_TEST_SITE
#   --ref <commit>  build that instead of origin/main (a release is built
#                   from main; this is for trying a branch)
#   --revision <n>  the exe's patch revision instead of the current exe's + 1
#   --patches <list>  the offered-patch list whose patches the exe requires,
#                   instead of release/patches.tsv (--test: patches-test.tsv);
#                   release.sh passes its list with the release's new patch
#   --work <dir>    an empty or new folder for it all (default: a new one
#                   under $TMPDIR); the ZIP is <work>/Survarium-0.26g-srp-files.zip
#
# Reads only; builds at nice 10. Remove the worktree after with:
#   git worktree remove <work>/src
. "$(dirname "$0")/lib.sh"

test_server=0 ref=origin/main work='' revision='' patches=''
while (($#)); do
    case $1 in
    -h | --help) usage ;;
    --test) test_server=1; shift ;;
    --ref) (($# >= 2)) || usage 1; ref=$2; shift 2 ;;
    --revision) (($# >= 2)) || usage 1; revision=$2; shift 2 ;;
    --patches) (($# >= 2)) || usage 1; patches=$2; shift 2 ;;
    --work) (($# >= 2)) || usage 1; work=$2; shift 2 ;;
    *) die "unknown argument $1 (--help)" ;;
    esac
done
need_cmds git nix curl sha256sum od jq
[[ -z $revision ]] || is_revision "$revision" || die "--revision $revision: a revision is 1 to 255"
lower_priority
load_env SKHID_GAME SKHID_SITE
if ((test_server)); then
    load_env SKHID_TEST_GAME_SERVER SKHID_TEST_SITE
    server=$SKHID_TEST_GAME_SERVER site=${SKHID_TEST_SITE%/}
else
    load_env SKHID_GAME_SERVER
    server=$SKHID_GAME_SERVER site=${SKHID_SITE%/}
fi
# The patches the exe requires: those of the offered-patch list.
if ((test_server)); then use_patches test; else use_patches live; fi
if [[ -n $patches ]]; then PATCH_LIST=$patches; fi
read_patch_list
required=$(list_numbers)
[[ -n $required ]] || die "$PATCH_LIST names no patch: the exe would require none (patch 49)"
[[ -n $GAME_ROW ]] || say "WARNING: $GAME_LIST has no row of $GAME_NAME: the updater and Skhid-without-updater.bat get no address of the game built in"
builtin_patches=$(list_patches_json) builtin_game=$(list_game_json)
[[ -d $SKHID_GAME ]] || die "SKHID_GAME: $SKHID_GAME is not a folder"
if [[ -z $work ]]; then
    work=$(mktemp -d "${TMPDIR:-/tmp}/skhid-zip.XXXXXX")
else
    mkdir -p "$work"
    [[ -z $(ls -A "$work") ]] || die "$work: not empty"
    work=$(cd "$work" && pwd)
fi
say "working in $work"

# 1. The source.
if [[ $ref == origin/main ]]; then
    git -C "$ROOT" fetch --quiet origin main:refs/remotes/origin/main
fi
git -C "$ROOT" worktree add --quiet --detach "$work/src" "$ref"
trap 'say "remove the worktree after: git -C $(q "$ROOT") worktree remove --force $(q "$work/src")"' EXIT
commit=$(git -C "$work/src" log -1 --format='%h %s')
say "building $ref: $commit"
recorded=$(sed -n 's/^REVISION = \([0-9][0-9]*\)$/\1/p' "$work/src/srp-026g/client-patches/patch_026g.py")
is_revision "$recorded" || die "no REVISION in patch_026g.py of $ref"

# 2. The current ZIP (the "live" one: of the target), its exe's revision, and
# the build's: that + 1, or --revision.
live_url=$site/download
fetch_site_zip "$site" "$work/live.zip"
live_revision=$(zip_revision "$work/live.zip" "$work/live.exe")
if [[ -z $revision ]]; then
    [[ $live_revision != unknown ]] || die "the exe of $live_url says no revision this script can read: name the build's with --revision <n>"
    revision=$((live_revision + 1))
fi
say "patch revision: $revision for this build ($live_revision live, REVISION $recorded on $ref, the last release's)"
say "required patches: ${required//,/, } (every patch of $PATCH_LIST)"
((revision >= recorded)) || die "revision $revision is below REVISION $recorded of $ref (patch_026g.py builds none below the last release's)"
if [[ $live_revision == unknown ]]; then
    say "WARNING: the live exe's revision cannot be read; compare by hand"
elif ((revision <= live_revision && test_server)); then
    say "revision $revision is not above the test server's $live_revision: fine for the test environment"
elif ((revision <= live_revision)); then
    die "revision $revision is not above the live exe's $live_revision: a release's revision is above it (the default: + 1)"
fi

# 3. The build.
say "building bugtrap.dll and updater_skhid.exe (log: $work/build.log) ..."
# SKHID_REVISION: their version resource says this release's revision
# (FileVersion <n>.0.0.0, ProductVersion "revision <n>"; client/windows_build.rs).
if ! (cd "$work/src" && SKHID_REVISION=$revision SKHID_BUILTIN_PATCHES=$builtin_patches \
    SKHID_BUILTIN_GAME=$builtin_game nix develop ./srp-026g -c bash -c \
    'client/bugtrap/build.sh && bash client/updater/build.sh') >"$work/build.log" 2>&1; then
    tail -n 30 "$work/build.log" >&2
    die "the build failed (log: $work/build.log)"
fi
for built in client/bugtrap/target/i686-win7-windows-msvc/release/BugTrap.dll \
    client/updater/exe/target/i686-win7-windows-msvc/release/updater_skhid.exe; do
    python - "$work/src/$built" "revision $revision" <<'PY' || die "$built does not say revision $revision in its version resource"
import sys
sys.exit(sys.argv[2].encode("utf-16-le") + b"\0\0" not in open(sys.argv[1], "rb").read())
PY
done
zip=$work/Survarium-0.26g-srp-files.zip
original=$SKHID_GAME/binaries/x86/survarium.exe
if [[ ! -f $original ]]; then original=$SKHID_GAME/game/binaries/x86/survarium.exe; fi
# In the checkout's dev shell (client_patches_python): the exe's arena
# (`.srpx`) is linked from its sources there, with the lock's tools.
{ client_patches_python "$work/src" make_client_026g.py "$SKHID_GAME" "$zip" --pack-zip \
    --revision="$revision" --required-patches="$required" --downloads="$GAME_LIST" --downloads="$PATCH_LIST" \
    --server="$server" --site="$site" &&
    client_patches_python "$work/src" patch_026g.py "$original" "$work/without-server.exe" \
        --revision="$revision" --required-patches="$required"; } >"$work/make_client.log" 2>&1 || {
    tail -n 30 "$work/make_client.log" >&2
    die "make_client_026g.py or patch_026g.py failed (log: $work/make_client.log)"
}
zip_extract "$zip" "$ZIP_EXE" "$work/new.exe" || die "$zip has no $ZIP_EXE"
built_revision=$(exe_revision "$work/new.exe")
[[ $built_revision == "$revision" ]] || die "the built exe says revision $built_revision, not $revision"
[[ $(exe_revision "$work/without-server.exe") == "$revision" ]] || die "the exe without a server does not say revision $revision"
for built in new.exe without-server.exe; do
    [[ $(exe_required_patches "$work/$built") == "${required//,/ }" ]] ||
        die "$built does not require the patches ${required//,/, } (it requires: $(exe_required_patches "$work/$built" 2>&1 || true))"
done
printf '%s with-server\n%s without-server\n' "$(sha256_of "$work/new.exe")" "$(sha256_of "$work/without-server.exe")" >"$work/exe.sha256"

# 4. Entry by entry.
declare -A old new
while read -r sha path; do old[$path]=$sha; done < <(zip_hashes "$work/live.zip")
while read -r sha path; do new[$path]=$sha; done < <(zip_hashes "$zip")
say
say "the new ZIP against the live one ($live_url):"
changed=0
while IFS= read -r path; do
    if [[ -z ${old[$path]:-} ]]; then
        state=ADDED changed=1
    elif [[ -z ${new[$path]:-} ]]; then
        state=REMOVED changed=1
    elif [[ ${old[$path]} == "${new[$path]}" ]]; then
        state=same
    else
        state=CHANGED changed=1
    fi
    printf '  %-8s %s\n' "$state" "$path"
done < <(printf '%s\n' "${!old[@]}" "${!new[@]}" | LC_ALL=C sort -u)
((changed)) || say "  (nothing changed)"
updater=game/binaries/x86/updater_skhid.exe
say
if [[ -z ${new[$updater]:-} ]]; then
    say "updater_skhid.exe: NOT IN THE NEW ZIP"
elif [[ ${old[$updater]:-} == "${new[$updater]}" ]]; then
    say "updater_skhid.exe: unchanged (the same file as live)"
else
    say "updater_skhid.exe: CHANGED: players get the new updater at their next launcher start"
fi
say "Every other change must be explained by a merged change; anything else is unreleased work riding along: stop."
say
say "the exe: sha256 $(sha256_of "$work/new.exe") (--server=$server), $(sha256_of "$work/without-server.exe") without a server"
say "$zip: $(size_of "$zip") bytes, sha256 $(sha256_of "$zip"), revision $revision, server $server, requires patches ${required//,/, }"
