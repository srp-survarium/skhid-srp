#!/usr/bin/env bash
# usage: release/upload-patch [--test] [--dry-run] <resources.db.patch_<n>>
#
# Publishes one patch on the patches server ($SKHID_PATCHES_SSH,
# $SKHID_PATCHES_DIR, served at $SKHID_PATCHES_URL) and adds its row to the
# offered-patch list release/patches.tsv, never overwriting one:
#   1. refuses a patch not above every patch in the list, and one that is
#      already in it;
#   2. refuses if $SKHID_PATCHES_DIR/<name> is already there with other
#      bytes (the same bytes: it is published already, only the row is added);
#   3. uploads to <name>.tmp, checks its sha256 there, chmod 644, mv into
#      place (mv -n: an existing file is never replaced);
#   4. GET $SKHID_PATCHES_URL/<name> must answer 200 with the local file's
#      sha256;
#   5. adds `<name> <sha256> <size> <url>` to the list: commit it (the
#      release's record PR). Mirrors go after <url> in the row:
#      release/add-mirror.
# Each write asks y/N first, showing the command. --dry-run prints them only.
# A published patch is never changed or deleted: a fix is the next revision.
#
#   --test   the test environment's patches: $SKHID_TEST_PATCHES_SSH,
#            $SKHID_TEST_PATCHES_DIR, $SKHID_TEST_PATCHES_URL (never the
#            production ones) and release/patches-test.tsv
. "$(dirname "$0")/lib.sh"

file='' which=live
while (($#)); do
    case $1 in
    -h | --help) usage ;;
    --dry-run) DRY_RUN=1; shift ;;
    --test) which='test'; shift ;;
    -*) die "unknown option $1 (--help)" ;;
    *) [[ -z $file ]] || usage 1; file=$1; shift ;;
    esac
done
[[ -n $file ]] || usage 1
name=${file##*/}
number=$(patch_number "$name") ||
    die "$name: the name must be resources.db.patch_<n>, n from 1 to 255 without a leading zero"
[[ -f $file ]] || die "$file: no such file"
[[ ! -e $(dirname -- "$file")/$QUICK_MARK ]] ||
    die "$file is a quick build (release/build-content without --full: $QUICK_MARK beside it), for local tests: build it again with release/build-content $number --full"
[[ $(head -c 13 "$file") == little-endian ]] || die "$file: not an archive of the game (no \"little-endian\" header)"
need_cmds ssh curl sha256sum
load_env
use_patches "$which"
read_patch_list

sha=$(sha256_of "$file")
size=$(size_of "$file")
dir=$(q "$PATCHES_DIR")
url=$PATCHES_URL/$name
say "$name: $size bytes, sha256 $sha"
row=$(list_row "$name")
if [[ -n $row ]]; then
    [[ $row == "$name $sha $size $url" || $row == "$name $sha $size $url "* ]] ||
        die "$name is in $PATCH_LIST already, with OTHER bytes ($row); a published patch is never replaced: make the next revision"
    die "$name is in $PATCH_LIST already, with these same bytes: nothing to do"
fi
((number > LIST_TOP)) ||
    die "$name is not above every patch in $PATCH_LIST (resources.db.patch_$LIST_TOP): a new patch takes the new revision"

there=$(on_patches "cd $dir && if test -e $(q "$name"); then sha256sum < $(q "$name"); else echo none; fi")
if [[ $there != none ]]; then
    [[ ${there%% *} == "$sha" ]] ||
        die "$name is already published with OTHER bytes (sha256 ${there%% *}); a published patch is never replaced: make the next revision"
    say "$name is published already, with these same bytes (not in the list yet: an earlier run stopped?)"
else
    write_on patches "cat > $dir/$(q "$name.tmp")" "$file"
    if ((!DRY_RUN)); then
        uploaded=$(on_patches "sha256sum < $dir/$(q "$name.tmp")")
        [[ ${uploaded%% *} == "$sha" ]] ||
            die "$name.tmp on the server has sha256 ${uploaded%% *}, not $sha; it is left there as .tmp, nothing published"
        say "$name.tmp on the server: sha256 $sha, as here"
    fi
    write_on patches "cd $dir && test ! -e $(q "$name") && chmod 644 $(q "$name.tmp") && mv -n $(q "$name.tmp") $(q "$name") && test ! -e $(q "$name.tmp")"
fi
if ((DRY_RUN)); then
    say "[dry run] then: GET $url must answer 200 with sha256 $sha"
    say "[dry run] and: $name $sha $size $url added to $PATCH_LIST"
    exit 0
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
status=$(http_get "$url" "$work/$name")
[[ $status == 200 ]] || die "GET $url answered $status, not 200; not added to $PATCH_LIST"
got=$(sha256_of "$work/$name")
[[ $got == "$sha" ]] || die "GET $url gave sha256 $got, not $sha; not added to $PATCH_LIST"
say "published: $url (200, sha256 $sha)"
if [[ -s $PATCH_LIST && -n $(tail -c 1 "$PATCH_LIST") ]]; then echo >>"$PATCH_LIST"; fi
printf '%s\t%s\t%s\t%s\n' "$name" "$sha" "$size" "$url" >>"$PATCH_LIST"
say "added to $PATCH_LIST: commit it with the release's record"
if [[ $which == test ]]; then say "next: release/build-server-db --test"; else say "next: release/build-server-db"; fi
