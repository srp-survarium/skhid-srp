# The private values the skhid-release skill and the release/ scripts use. Copy to
# private/release/release.env in the main checkout (never published), fill
# in, chmod 600. The skill loads it with:
#   . "$(git rev-parse --path-format=absolute --git-common-dir)/../private/release/release.env"
# (the scripts load it themselves; SKHID_RELEASE_ENV=<file> names another).
# Every value here is a placeholder.

# Hosts. The live host is reached only through the jump host.
SKHID_JUMP=user@jump-host       # also runs the patches servers; its address is in the live SRP_ADMIN_IPS
SKHID_LIVE=user@live-host
SKHID_LIVE_DIR=/opt/srp-026g

# What the players' ZIP is built for, and its site.
SKHID_SITE=https://example.org
SKHID_GAME_SERVER=example.org:1234
SKHID_LOCALIZATION=english

# The patches server: plain file storage (HTTP is fine; files are checked by sha256).
SKHID_PATCHES_SSH=user@patches-host
SKHID_PATCHES_DIR=/srv/skhid-patches
SKHID_PATCHES_URL=http://203.0.113.5:8090
# Optional: the Caddyfile release/setup-patches-server keeps the site block in.
# SKHID_PATCHES_CADDYFILE=/etc/caddy/Caddyfile

# The test environment (release.sh --test, upload-patch --test, ...): its own
# host folder, site and patches server, never the production ones (the
# scripts refuse a test patches folder or URL that is the production one).
SKHID_TEST=user@test-host                     # reached directly (SKHID_TEST_VIA: through a host)
SKHID_TEST_DIR=/opt/srp-test
SKHID_TEST_SITE=https://test.example.org
SKHID_TEST_GAME_SERVER=test.example.org:2234
SKHID_TEST_PATCHES_SSH=user@test-host
SKHID_TEST_PATCHES_DIR=/srv/skhid-patches-test
SKHID_TEST_PATCHES_URL=http://203.0.113.5:8091
# SKHID_TEST_COMPOSE="docker compose -p srptest"   # the default
# SKHID_TEST_PATCHES_CADDYFILE=/etc/caddy/Caddyfile
# SKHID_TEST_VIA=                                   # empty: directly

# Local inputs.
SKHID_GAME=/path/to/Survarium            # the original 0.26g install
SKHID_STOCK_DB=/path/to/resources.db     # the stock 0.26g resources.db (sha256 c74078be…)
# SKHID_DBGRAB=/path/to/dbgrab          # release/build-site (the Maps tab, the calculator); default: built from tools/re-kit with tools/vostok-resources-db of the main checkout

# release/release.sh and release/deploy. All optional; the defaults are shown.
# SKHID_MATCH_WAIT_MINUTES=15      # after the planned time, how long to wait for a match still running (--match-wait; --no-maintenance: 120)
# SKHID_SWAP_ANSWER_MINUTES=10     # no answer to the question before the swap in this time: no
# SKHID_MIN_FREE_MB=4096           # free space wanted here (the ZIP's worktree and build)
# SKHID_LIVE_MIN_FREE_MB=2048      # free space wanted in the target's folder (a release folder, an image build)
# SKHID_RELEASE_LOCK=skhid-release-<live|test>.lock   # the lock folder on $SKHID_JUMP (relative: in its home)
# SKHID_BACKUP_DIR=/srv/skhid-backups/srp-db          # on $SKHID_JUMP: srp.db of before each live release
# SKHID_PATCH_LIST=release/patches.tsv                # the offered-patch lists (the committed ones)
# SKHID_TEST_PATCH_LIST=release/patches-test.tsv
