[Unit]
Description=Skhid status board (read-only page, tools/board)
After=network-online.target
Wants=network-online.target

[Service]
# BOARD_SECRET=<64 hex characters>; mode 600, read by systemd before the service starts.
EnvironmentFile=/etc/skhid-board/env
ExecStart=/opt/skhid-board/skhid-board --bind 0.0.0.0 --port 8095 --data /opt/skhid-board/board.json
Restart=on-failure
RestartSec=2

DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/skhid-board
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=64M
TasksMax=64

[Install]
WantedBy=multi-user.target
